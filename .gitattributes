# Set default behavior to automatically normalize line endings
* text=auto

# Force LF line endings for shell scripts and Dockerfiles
*.sh text eol=lf
Dockerfile* text eol=lf
dockerfile* text eol=lf
*.dockerfile text eol=lf

# Force LF for YAML files
*.yml text eol=lf
*.yaml text eol=lf
docker-compose.yml text eol=lf
docker-compose.yaml text eol=lf

# Force LF for configuration files
.env* text eol=lf
*.conf text eol=lf
*.config text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf

# Force LF for documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
README text eol=lf

# Force LF for source code
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.py text eol=lf
*.go text eol=lf
*.java text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.rs text eol=lf
*.rb text eol=lf
*.php text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Docker specific binary files
*.tar.gz binary
*.tar.bz2 binary
*.tar.xz binary